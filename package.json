{
  "name": "@letta-ai/trajectory",
  "version": "0.2.3",
  "packageManager": "bun@1.3.0",
  "description": "Normalize native agent transcripts into a shared trajectory format.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/letta-ai/trajectory"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/trajectory-v1.schema.json",
    "./schema/canonical": "./schema/trajectory-canonical-v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "helpers",
    "schema",
    "prompts",
    "README.md",
    "PARITY.md",
    "CANONICAL.md",
    "SOURCE_VERSION_AUDIT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:python-cli": "bun build ./src/python-cli.ts --target=node --format=esm --outfile=python/src/trajectory/_vendor/trajectory-cli.mjs && cp helpers/deepagents_checkpoint.py python/src/trajectory/_vendor/deepagents_checkpoint.py",
    "audit:versions": "bun scripts/audit-source-versions.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run build:python-cli && git diff --exit-code -- python/src/trajectory/_vendor/trajectory-cli.mjs python/src/trajectory/_vendor/deepagents_checkpoint.py && bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
