{
  "name": "@letta-ai/trajectory",
  "version": "0.1.0",
  "packageManager": "bun@1.3.0",
  "description": "Normalize native agent transcripts into a shared trajectory format.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/letta-ai/trajectory"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/trajectory-v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "prompts",
    "README.md",
    "PARITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
